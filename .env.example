# Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Procesamiento con IA (opcional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DIRECTOR CA46 (solo servidor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Google Drive / almacenamiento
# OAuth: el usuario elige su cuenta y CA46 crea las carpetas en ese Drive.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DRIVE_OAUTH_STATE_SECRET=

# Cuenta de servicio que recibe acceso a la carpeta creada para sincronización de servidor.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Compatibilidad con instalaciones antiguas; no se usa para nuevas conexiones OAuth.
DRIVE_ROOT_FOLDER_ID=

# Otros almacenamientos opcionales
GCS_BUCKET_NAME=
GCS_REGION=

# Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Pagos y facturación (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AUTONOMO=
STRIPE_PRICE_EMPRESA=
RESEND_API_KEY=
INVOICE_FROM_EMAIL=
VERIFACTU_CONNECTOR_READY=false

# Tareas servidor (opcional)
CRON_SECRET=
