import React from 'react';

interface DigitalTag {
  id: number;
  product_name: string;
  price: number | null;
  unit: string | null;
  origin: string | null;
  category: string | null;
  created_at: string;
  expires_at: string;
}

interface TagCardProps {
  tag: DigitalTag;
}

export default function TagCard({ tag }: TagCardProps) {
  const isFresh = new Date(tag.created_at).getTime() > Date.now() - 24 * 60 * 60 * 1000; // Creado hace menos de 24h

  return (
    <div className="relative overflow-hidden rounded-2xl bg-white/5 backdrop-blur-xl border border-white/10 p-6 shadow-2xl transition-all duration-300 hover:-translate-y-2 hover:shadow-cyan-500/20 group">
      {/* Glow Effect */}
      <div className="absolute inset-0 bg-gradient-to-br from-cyan-500/10 to-blue-600/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
      
      {/* Header */}
      <div className="flex justify-between items-start mb-4 relative z-10">
        <div>
          <h3 className="text-xl font-bold text-white tracking-tight uppercase">{tag.product_name}</h3>
          <p className="text-sm text-cyan-400 font-medium tracking-wider">{tag.category || 'General'}</p>
        </div>
        {isFresh && (
          <span className="px-3 py-1 text-xs font-bold text-white bg-green-500/80 rounded-full animate-pulse shadow-[0_0_10px_rgba(34,197,94,0.5)]">
            FRESCO
          </span>
        )}
      </div>

      {/* Body */}
      <div className="space-y-3 relative z-10">
        {tag.origin && (
          <div className="flex items-center text-sm text-gray-300">
            <svg className="w-4 h-4 mr-2 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            Origen: <span className="ml-1 text-white">{tag.origin}</span>
          </div>
        )}
        
        {/* Precio o Estado */}
        <div className="mt-6 pt-4 border-t border-white/10">
          <div className="flex justify-between items-end">
            <div>
              <p className="text-xs text-gray-400 uppercase tracking-widest">Estado</p>
              <p className="text-lg font-semibold text-white">Disponible</p>
            </div>
            {tag.price !== null && tag.price > 0 && (
              <div className="text-right">
                 <p className="text-xs text-gray-400 uppercase tracking-widest">Precio</p>
                 <p className="text-2xl font-black text-cyan-400">
                   {tag.price.toFixed(2)}€ <span className="text-sm font-normal text-gray-400">/{tag.unit || 'kg'}</span>
                 </p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
